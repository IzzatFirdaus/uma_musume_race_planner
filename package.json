{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "playwright:install": "playwright install",
        "playwright:test": "playwright test",
    "test": "jest",
    "test:a11y": "playwright test tests/playwright/accessibility.spec.ts",
    "lighthouse-ci": "lhci autorun --config=.lighthouseci/lighthouserc.json",
        "lint:css": "stylelint \"resources/**/*.css\"",
        "lint:css:fix": "stylelint \"resources/**/*.css\" --fix",
        "prettier:check": "prettier --check \"**/*.{js,ts,jsx,tsx,css,scss,md,markdown,json,yml,yaml,html,vue}\"",
        "prettier:fix": "prettier --write \"**/*.{js,ts,jsx,tsx,css,scss,md,markdown,json,yml,yaml,html,vue}\""
    },
    "devDependencies": {
        "@playwright/test": "^1.55.0",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.8.2",
        "concurrently": "^9.0.1",
        "jest": "^30.1.3",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.6.2",
        "stylelint": "^16.23.1",
        "stylelint-config-recommended": "^17.0.0",
        "stylelint-config-standard": "^39.0.0",
        "stylelint-config-tailwindcss": "^1.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.4"
    },
    "dependencies": {
        "node-fetch": "^2.7.0",
        "sweetalert2": "^11.23.0"
    }
}
