{
    "ci": {
        "collect": {
            "numberOfRuns": 3,
            "urls": [
                "http://localhost:5173",
                "http://localhost:5173/dashboard"
            ],
            "settings": {
                "chromeFlags": "--no-sandbox --headless --disable-gpu",
                "skipAudits": [],
                "skipWaitForLoad": false
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        },
        "assert": {
            "preset": "lighthouse:recommended",
            "assertions": {
                "cumulativeLayoutShift": [
                    "error",
                    {
                        "maxNumericValue": 0.1
                    }
                ],
                "largest-contentful-paint": [
                    "error",
                    {
                        "maxNumericValue": 2500
                    }
                ],
                "total-blocking-time": [
                    "error",
                    {
                        "maxNumericValue": 200
                    }
                ],
                "first-input-delay": [
                    "error",
                    {
                        "maxNumericValue": 100
                    }
                ],
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.85
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ],
                "categories:best-practices": [
                    "error",
                    {
                        "minScore": 0.9
                    }
                ]
            }
        }
    }
}
